---
import Navbar from '../components/home/navbar.jsx';
import Footer from '../components/home/footer.jsx';
import schedule from '../data/schedule.js';
import { formatDate, isUpcoming, toDate } from '../data/formatDate.js';
import '../components/css/pages.css';

const withLabel = schedule.map((e) => ({
  ...e,
  shownDate: e.dateLabel || formatDate(e.date)
}));

const byDateAsc = (a, b) => {
  // sortDate carries an approximate date for entries whose month is known but
  // whose day is not, so they land in the right place on the timeline.
  const da = toDate(a.date || a.sortDate);
  const db = toDate(b.date || b.sortDate);
  if (!da && !db) return 0;
  if (!da) return 1;   // undated entries sink to the bottom of Upcoming
  if (!db) return -1;
  return da - db;
};

// Upcoming runs soonest first, past runs most recent first, so both read as
// "nearest to now" at the top and the next thing on is never below the fold.
const upcoming = withLabel.filter((e) => isUpcoming(e.date)).sort(byDateAsc);
const past = withLabel.filter((e) => !isUpcoming(e.date)).sort((a, b) => byDateAsc(b, a));

const today = formatDate(new Date().toISOString().slice(0, 10));
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Schedule | Johns Creek FBLA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Upcoming and past meetings, conferences, and events for Johns Creek High School FBLA." />
  <link href="https://fonts.googleapis.com/css?family=Oswald&display=swap" rel="stylesheet">
  <style>
    html, body { margin: 0; padding: 0; background-color: #f7f7f7; font-family: 'Oswald', sans-serif; }
  </style>
</head>
<body>
  <Navbar client:load />
  <main class="page">
    <header class="page-heading">
      <h1>Schedule</h1>
      <p class="page-intro">
        Every meeting, conference, and deadline in one place. Chapter meetings are
        usually the last Tuesday of the month in Commander Schenk's room; dates
        marked tentative are confirmed about a week ahead.
      </p>
      <a class="page-cta" href="/calendar">Open the calendar</a>
    </header>

    <section class="timeline-section">
      <h2 class="timeline-heading">Coming up</h2>

      {upcoming.length > 0 ? (
        <ol class="timeline">
          <li class="tl-node tl-today">
            <span class="tl-dot" aria-hidden="true"></span>
            <p class="tl-today-label">Today &middot; {today}</p>
          </li>

          {upcoming.map((e) => (
            <li class={`tl-node tl-${e.kind}${e.tentative ? ' tl-tentative' : ''}`}>
              <span class="tl-dot" aria-hidden="true"></span>
              <div class="tl-card">
                <p class="tl-when">
                  {e.shownDate}
                  {e.tentative && <span class="tl-chip">tentative</span>}
                </p>
                <h3 class="tl-title">
                  {e.link ? <a href={e.link}>{e.title}</a> : e.title}
                </h3>
                {e.location && <p class="tl-where">{e.location}</p>}
                {e.note && <p class="tl-note">{e.note}</p>}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-note">Nothing scheduled yet. Check back soon.</p>
      )}
    </section>

    <section class="timeline-section">
      <h2 class="timeline-heading">Already happened</h2>

      {past.length > 0 ? (
        <ol class="timeline timeline-past">
          {past.map((e) => (
            <li class={`tl-node tl-${e.kind}`}>
              <span class="tl-dot" aria-hidden="true"></span>
              <div class="tl-card">
                <p class="tl-when">{e.shownDate}</p>
                <h3 class="tl-title">
                  {e.link ? <a href={e.link}>{e.title}</a> : e.title}
                </h3>
                {e.location && <p class="tl-where">{e.location}</p>}
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="empty-note">Nothing here yet.</p>
      )}
    </section>
  </main>
  <Footer client:load />
</body>
</html>
