---
import Navbar from '../components/home/navbar.jsx';
import Footer from '../components/home/footer.jsx';
import news from '../data/news.js';
import { formatDate } from '../data/formatDate.js';
import '../components/css/pages.css';

const posts = [...news].sort((a, b) => (a.date < b.date ? 1 : -1));
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>News & Announcements | Johns Creek FBLA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Latest news and announcements from Johns Creek High School FBLA." />
  <link href="https://fonts.googleapis.com/css?family=Oswald&display=swap" rel="stylesheet">
  <style>
    html, body { margin: 0; padding: 0; background-color: #f7f7f7; font-family: 'Oswald', sans-serif; }
  </style>
</head>
<body>
  <Navbar client:load />
  <main class="page">
    <header class="page-heading">
      <h1>News & Announcements</h1>
      <p class="page-intro">Chapter updates, deadlines, and things you should not miss.</p>
    </header>

    {posts.length > 0 ? (
      <div class="news-list">
        {posts.map((post) => (
          <article class="news-item">
            <p class="news-date">{formatDate(post.date)}</p>
            <h2>{post.title}</h2>
            <p class="news-body">{post.body}</p>
            {post.link && (
              <a class="news-link" href={post.link}>{post.linkText || 'Read more'}</a>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-note">No announcements yet this year.</p>
    )}
  </main>
  <Footer client:load />
</body>
</html>
