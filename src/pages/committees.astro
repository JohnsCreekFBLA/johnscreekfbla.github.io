---
import Navbar from '../components/home/navbar.jsx';
import Footer from '../components/home/footer.jsx';
import committees from '../data/committees.js';
import '../components/css/pages.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Committees | Johns Creek FBLA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Membership, Marketing, and Competitions committees for Johns Creek High School FBLA." />
  <link href="https://fonts.googleapis.com/css?family=Oswald&display=swap" rel="stylesheet">
  <style>
    html, body { margin: 0; padding: 0; background-color: #f7f7f7; font-family: 'Oswald', sans-serif; }
  </style>
</head>
<body>
  <Navbar client:load />
  <main class="page">
    <header class="page-heading">
      <h1>Committees</h1>
      <p class="page-intro">
        Three committees keep the chapter running and keep this site current. If you
        have something that belongs on the website, it goes through one of them.
      </p>
    </header>

    <div class="committee-grid">
      {committees.map((c) => (
        <section class="committee-card" id={c.id}>
          <h2>{c.name}</h2>
          <p class="committee-lead">{c.lead} <span>· {c.role}</span></p>
          <p class="committee-blurb">{c.blurb}</p>
          <h3>Owns on this site</h3>
          <ul>
            {c.owns.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      ))}
    </div>

    <section class="panel">
      <div class="panel-header">
        <h2>Submitting something for the website</h2>
      </div>
      <p class="panel-body">
        Photos, announcements, results, forms, and event details all come from the
        committees. Send them to your committee lead and they reach the web team.
        Anything submitted by Sunday goes live that week.
      </p>
    </section>
  </main>
  <Footer client:load />
</body>
</html>
