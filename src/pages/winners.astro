---
import Navbar from '../components/home/navbar.jsx';
import Footer from '../components/home/footer.jsx';
import winners from '../data/winners.js';
import '../components/css/pages.css';
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Winners & Recognition | Johns Creek FBLA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Competition results and recognition for Johns Creek High School FBLA." />
  <link href="https://fonts.googleapis.com/css?family=Oswald&display=swap" rel="stylesheet">
  <style>
    html, body { margin: 0; padding: 0; background-color: #f7f7f7; font-family: 'Oswald', sans-serif; }
  </style>
</head>
<body>
  <Navbar client:load />
  <main class="page">
    <header class="page-heading">
      <h1>Winners & Recognition</h1>
      <p class="page-intro">
        Our members compete at region, state, and national level every year. Here is
        how they placed.
      </p>
    </header>

    {winners.map((block) => (
      <section class="panel" id={block.id}>
        <div class="panel-header">
          <h2>{block.conference}</h2>
          <p>
            {block.dateLabel}{block.location ? ` · ${block.location}` : ''}
          </p>
        </div>

        {block.results.length > 0 ? (
          <table class="results-table">
            <thead>
              <tr>
                <th scope="col">Place</th>
                <th scope="col">Member</th>
                <th scope="col">Event</th>
              </tr>
            </thead>
            <tbody>
              {block.results.map((r) => (
                <tr>
                  <td class="place">{r.place}</td>
                  <td>{r.name}</td>
                  <td>{r.event}</td>
                </tr>
              ))}
            </tbody>
          </table>
        ) : (
          <p class="empty-note">Results are being compiled. Check back soon.</p>
        )}
      </section>
    ))}

    <p class="page-footnote">
      Placed at a conference and don't see your name? Let the Competitions committee
      know and we'll add it.
    </p>
  </main>
  <Footer client:load />
</body>
</html>
