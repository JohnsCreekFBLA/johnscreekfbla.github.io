---
import Navbar from '../components/home/navbar.jsx';
import Footer from '../components/home/footer.jsx';
import GalleryCarousel from '../components/gallery/GalleryCarousel.jsx';
import conferenceGallery from '../data/conferenceGallery.js';
import '../components/css/gallery.css';

const sections = conferenceGallery.filter(
  (section) => Array.isArray(section.images) && section.images.length > 0
);
---

<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Photo Gallery | Johns Creek FBLA</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Photos from Johns Creek High School FBLA conferences, meetings, and events." />
  <link href="https://fonts.googleapis.com/css?family=Oswald&display=swap" rel="stylesheet">
  <style>
    html, body {
      margin: 0;
      padding: 0;
      background-color: #f7f7f7;
      font-family: 'Oswald', sans-serif;
    }
  </style>
</head>
<body>
  <Navbar client:load />
  <main class="gallery-page">
    <header class="gallery-heading">
      <h1>Photo Gallery</h1>
      <p class="gallery-intro">
        Highlights from our chapter's conferences, meetings, and events. Hover to
        pause a row, click any photo to open it.
      </p>
    </header>

    {sections.length > 0 ? (
      sections.map((section) => (
        <GalleryCarousel section={section} client:visible />
      ))
    ) : (
      <p class="gallery-empty">Photos are on the way. Check back soon.</p>
    )}
  </main>
  <Footer client:load />
</body>
</html>
